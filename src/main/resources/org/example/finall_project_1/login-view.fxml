<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.finall_project_1.LoginController"
            prefWidth="400" prefHeight="300">

    <children>

        <Label text="Login"
               layoutX="170" layoutY="20"/>

        <TextField fx:id="username"
                   promptText="Username"
                   layoutX="120" layoutY="80"/>

        <PasswordField fx:id="password"
                       promptText="Password"
                       layoutX="120" layoutY="120"/>

        <Button text="Login"
                layoutX="170" layoutY="170"
                onAction="#handleLogin"/>

        <Label fx:id="message"
               layoutX="120" layoutY="210"/>

    </children>
</AnchorPane>
